## Slack, team communication tool.
# The apt version is outdated as of 2026-08-20
# Manual download should be preferred to get the latest version: https://slack.com/downloads/instructions/linux?ddl=1&build=deb
mkdir --parents /tmp/slack \
  && pushd /tmp/slack >/dev/null \
  && curl -Lo /tmp/slack/slack-desktop.deb 'https://downloads.slack-edge.com/desktop-releases/linux/x64/4.51.191/slack-desktop-4.51.191-amd64.deb' \
  && sudo apt install /tmp/slack/slack-desktop.deb \
  && popd >/dev/null \
  && rm -rf /tmp/slack

## Ollama, local LLMs (https://ollama.com/).
curl -fsSL https://ollama.com/install.sh | sh

# Configuration.

echo -n $HOSTNAME | sudo tee /etc/hostname >/dev/null
sudo usermod --groups=dialout,syslog,docker,wireshark,video,i2c,ollama --append $USER
sudo sysctl kernel.dmesg_restrict=0
rfkill unblock all

# Configure timezone
sudo ln -fs /usr/share/zoneinfo/Europe/Prague /etc/localtime

# Configure default applications
xdg-mime default org.gnome.eog.desktop image/jpeg
xdg-mime default org.gnome.eog.desktop image/jpg
xdg-mime default org.gnome.eog.desktop image/png
xdg-mime default org.pwmt.zathura.desktop application/pdf
xdg-mime default org.inkscape.Inkscape.desktop image/svg+xml

# Sway with NVIDIA.
pushd /tmp >/dev/null \
  && git clone https://github.com/crispyricepc/sway-nvidia \
  && sudo install -Dm755 sway-nvidia/sway-nvidia.sh "/usr/local/bin/sway-nvidia" \
  && sudo install -Dm644 sway-nvidia/sway-nvidia.desktop "/usr/share/wayland-sessions/sway-nvidia.desktop" \
  && sudo install -Dm644 sway-nvidia/wlroots-env-nvidia.sh "/usr/local/share/wlroots-nvidia/wlroots-env-nvidia.sh" \
  && popd >/dev/null \
  && rm -rf /tmp/sway-nvidia
{{- if eq .chezmoi.osRelease.versionID "22.04"}}
sudo cp /etc/gdm3/custom.conf /etc/gdm3/custom.conf.orig
sudo sed -i -e 's/WaylandEnable=false/WaylandEnable=true/' /etc/gdm3/custom.conf
{{- end}}

## Chezmoi (https://www.chezmoi.io/).
sh -c "$(curl -fsLS get.chezmoi.io)" -- init --apply galou \
  && mkdir --parents $HOME/.local/bin \
  && mv $HOME/bin/chezmoi $HOME/.local/bin \
  && rmdir $HOME/bin

# Keyboard layouts (from https://github/galou/dotfiles).
sudo install -Dm644 $HOME/.local/share/chezmoi/usr/share/X11/xkb/symbols/us_cz /usr/share/X11/xkb/symbols/
sudo install -Dm644 $HOME/.local/share/chezmoi/usr/share/X11/xkb/symbols/gael /usr/share/X11/xkb/symbols/

## Zsh.
chsh --shell /usr/bin/zsh
rg --generate=complete-zsh > ~/.local/share/zsh/site-functions

## Neovim
mkdir --parents $HOME/.config \
  && pushd $HOME/.config >/dev/null \
  && git clone https://github.com/galou/dotvim.git nvim \
  && popd >/dev/null

