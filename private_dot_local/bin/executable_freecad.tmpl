#!/bin/bash

PIXI_MANIFEST="$HOME/04-sources/freecad/FreeCAD/pixi.toml"
CMD=($HOME/.local/bin/pixi run --manifest-path "$PIXI_MANIFEST" freecad-debug)

if [[ -n "$PYTHONPATH" ]]; then
  IFS=':' read -ra PY_PATHS <<< "$PYTHONPATH"
  for path in "${PY_PATHS[@]}"; do
    CMD+=(--python-path "$path")
  done
fi

exec ${CMD[@]} $@

