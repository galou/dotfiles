#!/bin/bash

PIXI_MANIFEST="$HOME/04-sources/freecad/FreeCAD/pixi.toml"
PIXI_ENV="$HOME/04-sources/freecad/FreeCAD/.pixi/envs/default"
CMD=($HOME/.local/bin/pixi run --manifest-path "$PIXI_MANIFEST" freecad-rel-with-deb-info)

# Keep conda's transitive dependencies resolving inside the pixi env rather
# than against /usr, which otherwise breaks ifcopenshell (libcurl -> libssl)
# and lxml/urdf_parser_py (libxslt -> libxml2) whenever a ROS 2 setup is
# sourced. Two layers, cheapest first:
#
# 1. DT_RPATH on the executables. Normally the build already does this (preset
#    conda-linux-debug-local); this call is a no-op then, and repairs the
#    binaries if they were relinked by a plain `pixi run build`.
FREECAD_FIX_RPATH_QUIET=1 "$HOME/.local/bin/freecad-fix-rpath" 2>/dev/null || true

# 2. Fallback preload, for when patchelf is unavailable so layer 1 could not
#    run. Harmless otherwise: conda's OpenSSL 3.6 / libxml2 2.13 satisfy the
#    older system consumers too.
for _lib in libxml2.so.2 libssl.so.3 libcrypto.so.3; do
  if [[ -e "$PIXI_ENV/lib/$_lib" ]]; then
    LD_PRELOAD="$PIXI_ENV/lib/$_lib${LD_PRELOAD:+:$LD_PRELOAD}"
  fi
done
export LD_PRELOAD
unset _lib

if [[ -n "$PYTHONPATH" ]]; then
  IFS=':' read -ra PY_PATHS <<< "$PYTHONPATH"
  for path in "${PY_PATHS[@]}"; do
    CMD+=(--python-path "$path")
  done
fi

exec ${CMD[@]} $@
