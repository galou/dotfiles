#!/bin/bash
# One monitor.
# Usage: display-1 MONITOR
# Works both on X11 and on Wayland/sway, cf. display-utilities.

# For `best_connected`, `all_outputs_except`, `output_off`, `output_on_primary`.
source "$HOME/.local/share/shell/display-utilities" || exit 1

# Usage: display_single OUTPUT
display_single()
{
    PRIMARY=$(best_connected "$1")

    if ! [[ -z "$PRIMARY" ]]; then
        # Change ouputs only if primary is connected to avoid a blackout.
        # Turn off all outputs not being cited as primary.
        for OUTPUT in $(all_outputs_except "$PRIMARY"); do
            output_off "$OUTPUT"
        done

        output_on_primary "$PRIMARY"
    fi
}

if [[ -z "$1" ]]; then
    echo Usage: $0 MONITOR 1>&2
else
    display_single "$1"
fi
